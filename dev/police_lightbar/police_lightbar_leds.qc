// The PERPHeads light bar (models/perpheads/props/police_lightbar.mdl, workshop 2897742669), body only,
// every LED lens on its own material (materials/police_lightbar/lens_*.vmt, unlit). Skins light them: skin 0 unlit,
// then per scheme (police, fire, medical) x light mode (CODE 2, CODE 3) x phase (0, 1: half a period later) the lenses' flash_*
// materials, whose VMT proxies run the pattern (the $texturegroup is written by make_vmts.py; AudioEngine.LightbarSkin
// picks the skin). Model space as the original draws (long axis X, front +Y).
$modelname "perpheads/props/police_lightbar_leds.mdl"
$staticprop
$body "Body" "lightbar_leds.smd"
$surfaceprop "metal"
$illumposition 0 0 9.465
$cdmaterials "police_lightbar/"
$cdmaterials "models/jarheads/props/police_lightbar/"
$texturegroup "skinfamilies"
{
	{ "lens_front_driver_inner" "lens_front_driver_outer" "lens_front_passenger_inner" "lens_front_passenger_outer" "lens_rear_driver_inner" "lens_rear_driver_outer" "lens_rear_passenger_inner" "lens_rear_passenger_outer" "lens_rear_centre" "lens_corner_driver_front" "lens_corner_driver_side" "lens_corner_driver_rear" "lens_corner_passenger_front" "lens_corner_passenger_side" "lens_corner_passenger_rear" }
	{ "flash_large_red_code2_b" "flash_large_red_code2_a" "flash_large_blue_code2_a" "flash_large_blue_code2_b" "flash_large_red_code2_b" "flash_large_red_code2_a" "flash_large_blue_code2_a" "flash_large_blue_code2_b" "lens_rear_centre" "flash_small_red_code2_a" "flash_small_red_code2_a" "flash_small_red_code2_a" "flash_small_blue_code2_b" "flash_small_blue_code2_b" "flash_small_blue_code2_b" }
	{ "flash_large_red_code2_a" "flash_large_red_code2_b" "flash_large_blue_code2_b" "flash_large_blue_code2_a" "flash_large_red_code2_a" "flash_large_red_code2_b" "flash_large_blue_code2_b" "flash_large_blue_code2_a" "lens_rear_centre" "flash_small_red_code2_b" "flash_small_red_code2_b" "flash_small_red_code2_b" "flash_small_blue_code2_a" "flash_small_blue_code2_a" "flash_small_blue_code2_a" }
	{ "flash_large_red_code3_b" "flash_large_red_code3_a" "flash_large_blue_code3_a" "flash_large_blue_code3_b" "flash_large_red_code3_b" "flash_large_red_code3_a" "flash_large_blue_code3_a" "flash_large_blue_code3_b" "flash_large_white_code3_c" "flash_small_red_code3_a" "flash_small_red_code3_a" "flash_small_red_code3_a" "flash_small_blue_code3_b" "flash_small_blue_code3_b" "flash_small_blue_code3_b" }
